# Copy to .env and fill in. Nothing here is required to run ScopeStrength
# locally -- every setting has a working default.
#
# There is no dotenv library in this project: .env is sourced by your shell,
# so the lines use `export` and you start the server with
#
#     source .env && mix phx.server
#
# In production do NOT ship this file. Set real environment variables on the
# host instead (fly secrets set, docker -e / --env-file, systemd Environment=).

# ---------------------------------------------------------------------------
# File storage (progress photos, chat attachments, profile pictures)
# ---------------------------------------------------------------------------
# Leave all of this unset to store uploads on local disk under
# priv/static/uploads. That is the default and needs no configuration.
#
# NOTE: if you run in Docker, mount that directory as a volume or uploads are
# lost every time the container restarts.
#
# To use object storage instead, set S3_BUCKET. Works with AWS S3, Cloudflare
# R2, Backblaze B2, MinIO and DigitalOcean Spaces. Keep the bucket PRIVATE --
# files are served through presigned URLs that expire after an hour.
#
# export S3_BUCKET=scopestrength-uploads
# export S3_ACCESS_KEY_ID=
# export S3_SECRET_ACCESS_KEY=
# export S3_REGION=us-east-1
#
# Non-AWS providers also need an endpoint, e.g. for Cloudflare R2:
# export S3_HOST=<account-id>.r2.cloudflarestorage.com
# export S3_SCHEME=https://
# export S3_PORT=443

# ---------------------------------------------------------------------------
# Outgoing email (password resets, confirmations)
# ---------------------------------------------------------------------------
# Leave unset in development: mail is kept in memory and viewable at
# http://localhost:4000/dev/mailbox.
#
# In production pick ONE adapter. Any SMTP server works, so you never need an
# account with a particular provider:
#
# export MAILER_ADAPTER=smtp
# export SMTP_HOST=smtp.example.com
# export SMTP_PORT=587                # 465 for implicit TLS
# export SMTP_USERNAME=
# export SMTP_PASSWORD=
#
# Or an API provider (resend, sendgrid, postmark, mailgun):
#
# export MAILER_ADAPTER=resend
# export MAILER_API_KEY=
# export MAILGUN_DOMAIN=              # mailgun only
#
# The address mail is sent from:
# export MAIL_FROM="ScopeStrength <no-reply@example.com>"

# ---------------------------------------------------------------------------
# Public registration (/users/register)
# ---------------------------------------------------------------------------
# Registration is OPEN by default, so a fresh self-hosted install can create
# its first account. Anyone who can reach the page can create a trainer OR a
# client account -- there is no invite requirement or approval step.
#
# Once your accounts exist, most self-hosters will want to close it: a
# trainer adds clients from their own dashboard instead of clients (or new
# trainers) signing themselves up. The demo and login pages stay reachable
# either way.
#
# export REGISTRATION_ENABLED=false

# ---------------------------------------------------------------------------
# Read-only client API (/api)
# ---------------------------------------------------------------------------
# Off by default. Setting BOTH variables opens a small read-only JSON API over
# one client's own training data: workout history, exercise lookup, progression
# status and a progress summary. It exists so a local agent can answer
# questions like "what is my progression on incline dumbbell press".
#
# API_TOKEN is the bearer token callers must present. Generate one with:
#
#     mix run -e ':crypto.strong_rand_bytes(32) |> Base.url_encode64(padding: false) |> IO.puts()'
#
# API_USER_EMAIL picks WHOSE data the token may read -- it must be a user who
# has a client record. Anyone holding the token can read that client's entire
# training history, so treat it like a password and do not expose /api to the
# internet without TLS.
#
# export API_TOKEN=
# export API_USER_EMAIL=you@example.com
